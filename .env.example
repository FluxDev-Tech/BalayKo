# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Map and Routing Services (Optional - Leaflet & OpenStreetMap are active by default)
# OPENSTREETMAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# OSRM_ROUTING_ENDPOINT="https://router.project-osrm.org/route/v1/driving"

